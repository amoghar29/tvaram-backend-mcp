# Copy to .env and adjust. Every value below is the built-in default, so the
# project runs with no .env at all.

# --- Mock backend (mock_server.py) ---
MOCK_HOST=127.0.0.1
MOCK_PORT=8000
# Credentials the mock accepts on POST /api/v1/auth/token.
MOCK_CLIENT_ID=tvram-mcp
MOCK_CLIENT_SECRET=local-dev-secret
# How long an issued token stays valid, in seconds.
MOCK_TOKEN_TTL_SECONDS=300

# --- MCP server (mcp_server.py) ---
MCP_HOST=127.0.0.1
MCP_PORT=8001
# The OAuth issuer, so it has to be the URL the browser reaches, not the bind
# address. Change it if you put the server behind a tunnel or a proxy.
MCP_BASE_URL=http://127.0.0.1:8001
# Set to "false" to serve the MCP endpoint without OAuth.
MCP_AUTH=true

# --- The backend the MCP server calls ---
# Point this at a real verification API to swap the mock out; nothing else
# needs to change.
VERIFIER_BASE_URL=http://127.0.0.1:8000
VERIFIER_CLIENT_ID=tvram-mcp
VERIFIER_CLIENT_SECRET=local-dev-secret
